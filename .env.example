# Copia este archivo como .env y completa con los datos de tu proyecto de Supabase
# (Project Settings → API). Sin estas variables la app funciona en modo demo.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-o-publishable-key
EXPO_PUBLIC_INMOBILIARIA=habitat-demo
